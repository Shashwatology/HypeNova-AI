# HypeNova AI Environment Configuration

# Server Settings
HYPENOVA_HOST=127.0.0.1
HYPENOVA_PORT=8000
HYPENOVA_ENV=development

# Optional YouTube Data API v3 (For high-volume keyword and view velocity search)
# Get a free key at: https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Automation Cadence
DISCOVERY_INTERVAL_HOURS=6
QUEUE_UPDATE_INTERVAL_HOURS=2
ANALYTICS_INTERVAL_HOURS=24

# Publishing Defaults
DEFAULT_PUBLISH_MODE=HUMAN_APPROVAL
ALLOW_AUTO_PUBLISH_EXTERNAL_CREATORS=false

# PostKaro Handoff
POSTKARO_ENABLED=true
